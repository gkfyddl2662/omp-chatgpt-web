# Optional browser override. If omitted, common Chrome/Chromium paths are probed.
# OMP_CHATGPT_WEB_BROWSER=/usr/bin/google-chrome

# Persistent ChatGPT browser profile used by the OMP extension.
# OMP_CHATGPT_WEB_PROFILE=/home/you/.omp/chatgpt-web/chrome

# ChatGPT custom connector name. Create the connector with this exact name.
OMP_CHATGPT_WEB_CONNECTOR=OMP Local

# Loopback MCP server port.
OMP_CHATGPT_WEB_MCP_PORT=8791

# Approval prompts fail closed by default. Set to 1 only if you explicitly want
# the browser worker to click "Allow once" for ChatGPT MCP calls.
OMP_CHATGPT_WEB_AUTO_APPROVE=0

# OpenAI Secure MCP Tunnel runtime credentials.
CONTROL_PLANE_TUNNEL_ID=tunnel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTROL_PLANE_API_KEY=sk-...

# Optional path when tunnel-client is not on PATH.
# TUNNEL_CLIENT_BIN=/path/to/tunnel-client
