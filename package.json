{
  "name": "omp-chatgpt-web",
  "version": "0.3.0-beta.1",
  "description": "Use normal ChatGPT Web as an Oh My Pi model provider while keeping OMP as the local agent and tool runtime.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/chatgpt-web/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gkfyddl2662/omp-chatgpt-web.git"
  },
  "homepage": "https://github.com/gkfyddl2662/omp-chatgpt-web#readme",
  "bugs": {
    "url": "https://github.com/gkfyddl2662/omp-chatgpt-web/issues"
  },
  "keywords": [
    "oh-my-pi",
    "omp",
    "chatgpt",
    "mcp",
    "playwright",
    "agent"
  ]
}
